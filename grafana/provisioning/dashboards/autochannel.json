  "refresh": "10s",
  "schemaVersion": 38,
  "tags": ["autochannel"],
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "AutoChannel Processing Metrics",
  "uid": "autochannel-metrics",
  "version": 1
}
